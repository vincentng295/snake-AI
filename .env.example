# Copy file này thành .env rồi sửa. Cạnh main.py.

# ---- Máy chủ ----
HOST=127.0.0.1
PORT=8888
# Trang tĩnh được phép gọi. "*" = cho mọi nguồn (bypass CORS). Muốn siết: nhiều nguồn cách nhau dấu phẩy
ALLOWED_ORIGINS=*
# ALLOWED_ORIGINS=https://snake-ai-mocha.vercel.app
SECRET_KEY=doi-thanh-chuoi-ngau-nhien
DB_PATH=./snake.db
QUESTION_FILE=./question.json

# ---- Cloudflare Tunnel ----
TUNNEL=true
TUNNEL_HOST=snake-ai.huskydg.io.vn
# Token của tunnel (Zero Trust > Networks > Tunnels). Để trống = domain tạm trycloudflare.com
TUNNEL_TOKEN=

# ---- Game ----
GAME_SIZE=40
TICK_MS=150
MAX_PLAYERS=24
HEARTS_START=5
HEARTS_MAX=10
POINTS_CORRECT=10
STREAK_BONUS=2
STREAK_BONUS_MAX=5
BITE_PENALTY=5
HEART_FULL_BONUS=3
ROUND_SECONDS=45
INTERMISSION_SECONDS=5
HEART_EVERY=25
HEART_LIFETIME=30
HEART_MAX_ON_MAP=3
GROW=2
MAX_LEN=40
SPAWN_PROTECT=2.5
AFK_SECONDS=90
RECONNECT_GRACE=20
ITEM_SPACING=10
